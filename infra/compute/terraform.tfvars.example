# Local values for this machine. Copy to terraform.tfvars — that name is git-ignored.
# Authenticate with `az login` before running terraform plan/apply.

# Azure subscription where the lab resources live.  <-- REPLACE THIS
subscription_id     = "00000000-0000-0000-0000-000000000000"

# Must match the network stack so both stacks agree on resource names.
environment         = "dev"

# Public key authorized on both VMs. Generate with:
#   ssh-keygen -t ed25519 -C "terraform-lab"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# VM size. Standard_B1s is the cheapest size that runs Docker comfortably.
vm_size             = "Standard_B1s"

# Set to false to remove the app VM's public IP and go back to jumpbox-only access.
app_public_ip_enabled = true
